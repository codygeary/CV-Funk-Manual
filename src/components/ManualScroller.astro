---
const { modules, currentCollection = 'free' } = Astro.props;

let base = import.meta.env.BASE_URL;
if (!base.endsWith('/')) base += '/';

// Convert "/panels/x.png" -> "<base>panels/x.png"
const asset = (p: string) => base + String(p).replace(/^\/+/, '');

// Figures: each module may list figures as
//   { id, src, srcDark?, caption?, alt?, section? }   (section defaults to "panelMap")
// A line "[[fig:<id>]]" in a section's text places that figure there.
// Figures that are not placed in any text go at the end of their section.
const FIG_LINE = /^\s*\[\[fig:([\w-]+)\]\]\s*$/;
type Part = { text?: string; fig?: any };
function sectionParts(m: any, key: string): Part[] {
  const figs: any[] = m.figures ?? [];
  const placed = new Set<string>();
  for (const t of Object.values(m.sections ?? {}) as string[])
    for (const line of String(t).split('\n')) { const k = line.match(FIG_LINE); if (k) placed.add(k[1]); }
  const out: Part[] = [];
  let buf: string[] = [];
  const flush = () => { const t = buf.join('\n').replace(/^\n+|\s+$/g, ''); if (t) out.push({ text: t }); buf = []; };
  for (const line of String(m.sections?.[key] ?? '').split('\n')) {
    const k = line.match(FIG_LINE);
    if (!k) { buf.push(line); continue; }
    flush();
    const f = figs.find((x) => x.id === k[1]);
    if (f) out.push({ fig: f });
  }
  flush();
  for (const f of figs) if (!placed.has(f.id) && (f.section ?? 'panelMap') === key) out.push({ fig: f });
  return out;
}
const hasSection = (m: any, key: string) =>
  !!m.sections?.[key]?.trim() || (m.figures ?? []).some((f: any) => (f.section ?? 'panelMap') === key);
// Videos: { id, title, by, start?, chapters?: [[seconds, label], ...] }
const ytUrl = (id: string, t = 0) => `https://www.youtube.com/watch?v=${id}${t ? `&t=${t}s` : ''}`;
const mmss = (t: number) => `${Math.floor(t / 60)}:${String(t % 60).padStart(2, '0')}`;
const SECTIONS: [string, string][] = [['panelMap', 'Panel map'], ['basicUse', 'Basic use'], ['patching', 'Patching suggestions']];
---

<section class="manual">
  <aside class="manual-left">
    <div class="sticky">
      <div class="left-top">
        <nav class="collections" aria-label="Collections">
          <a class={['tab', currentCollection === 'free'         && 'active'].filter(Boolean).join(' ')} href={`${base}free/`}>Free</a>
          <a class={['tab', currentCollection === 'modulations'  && 'active'].filter(Boolean).join(' ')} href={`${base}modulations/`}>Modulations</a>
          <a class={['tab', currentCollection === 'chord-caster' && 'active'].filter(Boolean).join(' ')} href={`${base}chord-caster/`}>Chord Caster</a>
          <a class={['tab', currentCollection === 'sands'        && 'active'].filter(Boolean).join(' ')} href={`${base}sands/`}>Sands</a>
        </nav>
        <div class="picker">
          <label class="picker-label" for="moduleJump">Jump</label>
          <select id="moduleJump" class="picker-select">
            {modules.map((m) => <option value={m.slug}>{m.name}</option>)}
          </select>
        </div>

        <div class="toggle">
          <button id="themeToggle" class="btn" type="button" aria-label="Toggle theme">Theme</button>
        </div>
      </div>

      <div class="panel-frame">
        <img id="panelImg" class="panel-img" src={asset(modules[0].panelImage)} alt={modules[0].name} loading="eager" />
        <div id="panelOverlay" class="panel-overlay">
          <div id="panelTitle" class="panel-title">{modules[0].name}</div>
          <div id="panelTagline" class="panel-tagline">{modules[0].tagline}</div>
        </div>
      </div>

      <div class="hint muted desktop-only scroll-hint" aria-hidden="true">
        Scroll on the right to advance modules.
      </div>
    </div>
  </aside>

  <div class="manual-right">
    {modules.map((m) => (
      <article
        id={m.slug}
        class="module"
        data-slug={m.slug}
        data-name={m.name}
        data-tagline={m.tagline}
        data-img={m.panelImage}
      >
        <header class="module-header">
          <h2 class="module-title">{m.name}</h2>
          <p class="module-tagline">{m.tagline}</p>
        </header>

        {SECTIONS.filter(([key]) => key === 'panelMap' || hasSection(m, key)).map(([key, label]) => (
          <section class="module-section">
            <h3>{label}</h3>
            {sectionParts(m, key).map((part) => part.fig ? (
              <figure class="module-figure">
                <img
                  src={asset(part.fig.src)}
                  data-light={asset(part.fig.src)}
                  data-dark={part.fig.srcDark ? asset(part.fig.srcDark) : undefined}
                  alt={part.fig.alt ?? part.fig.caption ?? ''}
                  loading="lazy"
                />
                {part.fig.caption ? <figcaption>{part.fig.caption}</figcaption> : null}
              </figure>
            ) : (
              <div class="prose"><pre>{part.text}</pre></div>
            ))}
          </section>
        ))}

        {m.videos?.length ? (
          <section class="module-section">
            <h3>Videos</h3>
            <ul class="module-videos">
              {m.videos.map((v) => (
                <li>
                  <a class="video-thumb" href={ytUrl(v.id, v.start)} target="_blank" rel="noreferrer">
                    <img src={`https://img.youtube.com/vi/${v.id}/mqdefault.jpg`} alt="" loading="lazy" />
                  </a>
                  <div>
                    <a href={ytUrl(v.id, v.start)} target="_blank" rel="noreferrer">{v.title}</a>
                    <div class="video-meta">{v.by}{v.start ? ` · from ${mmss(v.start)}` : ''}</div>
                    {v.chapters?.length ? (
                      <div class="video-chapters">
                        {v.chapters.map(([t, label]) => (
                          <a href={ytUrl(v.id, t)} target="_blank" rel="noreferrer">{mmss(t)} {label}</a>
                        ))}
                      </div>
                    ) : null}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ) : null}

        <div class="module-divider"></div>
      </article>
    ))}
  </div>

  <script>
    const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');

    function resolveAsset(p: string) {
      // "/panels/x.png" -> "<BASE>panels/x.png"
      return BASE + String(p).replace(/^\/+/, '');
    }
  
    const modules = Array.from(document.querySelectorAll('.module'));
    const panelImg    = document.getElementById('panelImg')    as HTMLImageElement;
    const panelTitle  = document.getElementById('panelTitle')  as HTMLElement;
    const panelTagline = document.getElementById('panelTagline') as HTMLElement;
    const moduleJump  = document.getElementById('moduleJump')  as HTMLSelectElement;
    const themeToggle = document.getElementById('themeToggle') as HTMLButtonElement;

    // ---- Theme helpers ----

    function toDarkVariant(src: string) {
      return src.replace(/\.(png|jpg|jpeg|webp)$/i, '-dark.$1');
    }
    
    function setPanelImage(lightSrc: string, name: string) {
      const isDark = document.documentElement.classList.contains('dark');

      const resolvedLight = resolveAsset(lightSrc);
      const resolvedDark  = toDarkVariant(resolvedLight);
      const desired = isDark ? resolvedDark : resolvedLight;

      panelImg.onerror = () => {
        // If dark variant is missing, fall back to light.
        if (panelImg.src.endsWith(resolvedDark)) {
          panelImg.onerror = null;
          panelImg.src = resolvedLight;
        }
      };

      panelImg.src = desired;
      panelImg.alt = name;
    }
    // ---- Active module ----

    function setActive(moduleEl: Element | null) {
      if (!moduleEl) return;
      const el = moduleEl as HTMLElement;
      setPanelImage(el.dataset.img!, el.dataset.name!);
      panelTitle.textContent  = el.dataset.name!;
      panelTagline.textContent = el.dataset.tagline!;
      moduleJump.value = el.dataset.slug!;
      modules.forEach((m) => m.classList.toggle('active', m === moduleEl));
    }

    // ---- Scroll spy ----

    const header = document.querySelector('.site-header');
    const manualRight = document.querySelector('.manual-right') as HTMLElement;

    function getScroller(): HTMLElement | Window {
      if (manualRight && manualRight.scrollHeight > manualRight.clientHeight + 2) return manualRight;
      return window;
    }

    let scroller = getScroller();

    function headerHeight() {
      return header ? (header as HTMLElement).getBoundingClientRect().height : 0;
    }

    function contentTop() {
      return headerHeight() + 12;
    }

    function pickByClosestTop() {
      const topRef = contentTop();
      const scrollerTop = (scroller === window) ? 0 : (scroller as HTMLElement).getBoundingClientRect().top;

      let best: Element | null = null;
      let bestDist = Infinity;

      for (const el of modules) {
        const r = el.getBoundingClientRect();
        const dist = Math.abs(r.top - (scrollerTop + topRef));

        const viewBottom = (scroller === window)
          ? window.innerHeight
          : (scroller as HTMLElement).getBoundingClientRect().bottom;

        if (r.top > viewBottom + 40) continue;
        if (dist < bestDist) { bestDist = dist; best = el; }
      }

      if (best) setActive(best);
    }

    // Intersection observer + scroll listener — rebuilt on resize
    function setupSpy() {
      scroller = getScroller();

      if ((window as any).__cvfunkIO) {
        try { (window as any).__cvfunkIO.disconnect(); } catch {}
      }
      if ((window as any).__cvfunkOnScroll && (window as any).__cvfunkScrollEl) {
        (window as any).__cvfunkScrollEl.removeEventListener('scroll', (window as any).__cvfunkOnScroll);
      }

      const rootEl = (scroller === window) ? null : scroller as HTMLElement;

      const io = new IntersectionObserver(
        () => pickByClosestTop(),
        {
          root: rootEl,
          rootMargin: `-${contentTop()}px 0px -70% 0px`,
          threshold: [0, 0.01],
        }
      );

      (window as any).__cvfunkIO = io;
      modules.forEach((m) => io.observe(m));

      const onScroll = () => pickByClosestTop();
      const scrollEl = (scroller === window) ? window : scroller;

      scrollEl.addEventListener('scroll', onScroll, { passive: true });
      (window as any).__cvfunkOnScroll = onScroll;
      (window as any).__cvfunkScrollEl = scrollEl;

      pickByClosestTop();
    }

    setupSpy();
    window.addEventListener('resize', setupSpy, { passive: true });

    // ---- Jump select ----

    moduleJump.addEventListener('change', (e) => {
      const slug = (e.target as HTMLSelectElement).value;
      const el = document.getElementById(slug);
      if (!el) return;

      const sc = getScroller();
      if (sc === window) {
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else {
        (sc as HTMLElement).scrollTo({ top: el.offsetTop, behavior: 'smooth' });
      }
    });

    // ---- Theme toggle ----

    themeToggle.addEventListener('click', () => {
      const html = document.documentElement;
      html.classList.toggle('dark');
      localStorage.setItem('cvfunk_theme', html.classList.contains('dark') ? 'dark' : 'light');

      const active = document.querySelector('.module.active') || modules[0];
      setActive(active);
      swapFigures();
    });

    // Restore saved theme
    (() => {
      const saved = localStorage.getItem('cvfunk_theme');
      if (saved === 'dark') document.documentElement.classList.add('dark');
    })();

    // Figures with a dark variant follow the theme
    function swapFigures() {
      const dark = document.documentElement.classList.contains('dark');
      document.querySelectorAll<HTMLImageElement>('.module-figure img[data-dark]').forEach((img) => {
        img.src = (dark ? img.dataset.dark : img.dataset.light) as string;
      });
    }

    // Init
    setActive(modules[0]);
    swapFigures();
  </script>
</section>
