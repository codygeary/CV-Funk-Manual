---
// Old collection page: now a view on the home page.
let base = import.meta.env.BASE_URL;
if (!base.endsWith('/')) base += '/';
const target = `${base}#c-chord-caster`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>CV funk Manual</title>
  </head>
  <body><p>Moved to <a href={target}>the CV funk manual</a>.</p></body>
</html>
